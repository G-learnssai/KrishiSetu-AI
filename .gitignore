# ==============================================================================
# KrishiSetu AI - .gitignore
# ==============================================================================

# Environment variable files and secrets
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
*.pem
*.key
*.cert
*.pfx
id_rsa*
serviceAccountKey*.json

# Dependency and package directories
node_modules/
jspm_packages/
package-lock.json

# Python cache and virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
dist/
*.egg-info/

# Logs and runtime databases
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids
*.pid
*.seed
*.pid.lock

# Operating System files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride

# IDE and Editor configurations
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# AI agent and temporary scratch files
.gemini/
scratch/
*hiSetu*
